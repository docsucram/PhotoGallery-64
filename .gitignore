# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Databases & WAL/SHM files (personal catalog data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
db/*.db
db/*.db-shm
db/*.db-wal
!db/schema.sql

# Non-destructive original file backups
.OriginalFiles/
*.bak

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest / Coverage / Caches
.pytest_cache/
.coverage
htmlcov/
*.log

# IDE & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Scratch / temporary experimental scripts & images
scratch/
